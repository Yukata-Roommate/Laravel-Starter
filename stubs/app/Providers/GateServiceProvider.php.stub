<?php

namespace App\Providers;

use YukataRm\Laravel\Provider\GateServiceProvider as ServiceProvider;

use App\Models\User;
use App\Enums\User\AbilityEnum;

/**
 * Gate Service Provider
 */
class GateServiceProvider extends ServiceProvider
{
    /**
     * define Gate
     *
     * @return void
     */
    protected function define(): void
    {
        $this->before(function (User $user, string $ability) {
            if ($user->role->isSystem()) return true;
        });

        $this->gate(AbilityEnum::ADMIN_HIGHER->value, function (User $user) {
            return AbilityEnum::ADMIN_HIGHER->check($user->role);
        });

        $this->gate(AbilityEnum::USER_HIGHER->value, function (User $user) {
            return AbilityEnum::USER_HIGHER->check($user->role);
        });
    }
}
